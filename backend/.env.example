# ── Required — the application will NOT start without these. ─────────
# Generate a strong random string (e.g. openssl rand -hex 32).
JWT_SECRET=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=stellarshunts

# ── Optional overrides (defaults shown). ─────────────────────────────
# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Auth
JWT_EXPIRES_IN=15m

# Database extras
DATABASE_SYNC=false
DATABASE_LOAD=false

# Stellar / Soroban
# STELLAR_MODE=mock          # mock | live
# STELLAR_NETWORK=testnet    # testnet | mainnet
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# SOROBAN_NFT_CONTRACT_ID=
# STELLAR_HUNTS_CONTRACT_ID=
# STELLAR_HUNTS_NFT_CONTRACT_ID=
#
# In `live` mode SOROBAN_RPC_URL and all contract IDs are REQUIRED;
# in `mock` mode they may be omitted.

# Redis (optional — app boots with degraded caching when unset)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
