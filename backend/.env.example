# ── Required — the application will NOT start without these. ─────────
# Generate a strong random string (e.g. openssl rand -hex 32).
JWT_SECRET=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=stellarshunts

# ── Optional overrides (defaults shown). ─────────────────────────────
# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Auth
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Database extras
# Booleans: exactly `true` enables the flag; anything else is rejected at
# startup rather than being silently treated as false.
DATABASE_SYNC=false
DATABASE_LOAD=false

# Stellar / Soroban
#
# The schema default for `STELLAR_MODE` is **live**, which is a fail-closed
# choice: a deployment that omits this variable without Soroban credentials
# fails at startup naming the missing keys, instead of booting "cleanly" and
# then handing out synthetic NFT successes. See
# backend/src/config/config.validation.ts for the full rationale.
#
# The line below is the local-development opt-in, not the default. Copy it
# as-is for a machine with no Stellar setup.
STELLAR_MODE=mock
# testnet | pubnet. Stellar's public network is `pubnet`; `mainnet` is the
# older name for the same network and is rejected by the schema.
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NFT_CONTRACT_ID=
STELLAR_HUNTS_CONTRACT_ID=
STELLAR_HUNTS_NFT_CONTRACT_ID=
#
# In `live` mode SOROBAN_RPC_URL and all contract IDs are REQUIRED;
# in `mock` mode they may be omitted.

# Redis (optional — app boots with degraded caching when unset)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
